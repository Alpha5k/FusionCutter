{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "ninja-base",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "x86-debug",
            "displayName": "x86 Debug",
            "inherits": "ninja-base",
            "binaryDir": "${sourceDir}/../build/x86-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "inherits": "ninja-base",
            "binaryDir": "${sourceDir}/../build/x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x86-release",
            "displayName": "x86 RelWithDebInfo",
            "inherits": "ninja-base",
            "binaryDir": "${sourceDir}/../build/x86-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 RelWithDebInfo",
            "inherits": "ninja-base",
            "binaryDir": "${sourceDir}/../build/x64-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x86-debug",
            "configurePreset": "x86-debug"
        },
        {
            "name": "x64-debug",
            "configurePreset": "x64-debug"
        },
        {
            "name": "x86-release",
            "configurePreset": "x86-release"
        },
        {
            "name": "x64-release",
            "configurePreset": "x64-release"
        }
    ],
    "testPresets": [
        {
            "name": "x86-debug",
            "configurePreset": "x86-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "x64-debug",
            "configurePreset": "x64-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "x86-release",
            "configurePreset": "x86-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "x64-release",
            "configurePreset": "x64-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        }
    ]
}
