# Parse the actual CLI report and compare its exit code and requested patch result.
file(READ "${FC_REPORT}" report)
string(JSON exit_code GET "${report}" exit_code)
if(NOT exit_code EQUAL FC_EXIT_CODE)
    message(FATAL_ERROR "Report exit code ${exit_code} differs from process exit code ${FC_EXIT_CODE}")
endif()

if(DEFINED FC_OWNER)
    string(JSON count LENGTH "${report}" checks)
    math(EXPR last "${count} - 1")
    set(found FALSE)
    foreach(index RANGE 0 ${last})
        string(JSON owner GET "${report}" checks ${index} owner)
        string(JSON operation GET "${report}" checks ${index} operation)
        if(owner STREQUAL FC_OWNER AND operation STREQUAL "Requested patch assertion")
            string(JSON status GET "${report}" checks ${index} status)
            if(NOT status STREQUAL FC_STATUS)
                message(FATAL_ERROR "Patch ${owner} returned ${status}, expected ${FC_STATUS}")
            endif()
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Patch ${FC_OWNER} was absent from the report")
    endif()
endif()

if(DEFINED FC_IMAGE_PATH)
    string(JSON image_path GET "${report}" images 0 path)
    if(NOT image_path STREQUAL FC_IMAGE_PATH)
        message(FATAL_ERROR "The report changed the Unicode image path")
    endif()
endif()
